{
  "name": "voyageboard-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "VoyageBoard monorepo - client and backend",
  "scripts": {
    "install:client": "cd client && npm install",
    "install:backend": "cd backend && npm install",
    "install:all": "npm run install:client && npm run install:backend",
    "dev:client": "cd client && npm run dev",
    "dev:backend": "cd backend && npm run dev",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:backend\"",
    "build:client": "cd client && npm run build",
    "build:backend": "cd backend && npm run build",
    "build": "npm run build:client && npm run build:backend"
  },
  "workspaces": [
    "client",
    "backend"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
