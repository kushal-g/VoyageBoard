  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate a new session token if it doesn't exist",
          "if (!pm.collectionVariables.get('session_token')) {",
          "    const uuid = require('uuid');",
          "    const sessionToken = uuid.v4();",
          "    pm.collectionVariables.set('session_token', sessionToken);",
          "    console.log('Generated new session token:', sessionToken);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001",
      "type": "string",
      "description": "Base URL for the VoyageBoard API"
    },
    {
      "key": "session_token",
      "value": "",
      "type": "string",
      "description": "Session token for Google Maps API billing optimization (auto-generated)"
    }
  ]
}
