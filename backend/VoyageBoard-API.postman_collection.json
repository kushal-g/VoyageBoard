    {
      "name": "Web Scraping",
      "item": [
        {
          "name": "Scrape Website - Basic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com\",\n  \"extractPlaces\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/scrape",
              "host": ["{{base_url}}"],
              "path": ["api", "scrape"]
            },
            "description": "Scrape a website using headless browser. Returns fully rendered HTML and parsed content (title, headings, links, images, text)."
          },
          "response": []
        },
        {
          "name": "Scrape Travel Blog - Extract Places",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com/travel-blog\",\n  \"extractPlaces\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/scrape",
              "host": ["{{base_url}}"],
              "path": ["api", "scrape"]
            },
            "description": "Scrape a travel blog and use Claude AI to extract all places, destinations, and attractions mentioned. When Google Maps API key is configured, each extracted place is automatically enriched with placeId, coordinates (latitude/longitude), and formattedAddress from Google Maps. Returns structured list of places with names, descriptions, types, locations, and Google Maps data."
          },
          "response": []
        },
        {
          "name": "Scrape Website - With Wait Selector",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://example.com\",\n  \"waitForSelector\": \"#content\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/scrape",
              "host": ["{{base_url}}"],
              "path": ["api", "scrape"]
            },
            "description": "Scrape a website and wait for a specific CSS selector to appear before extracting data. Useful for sites with dynamic content loading."
          },
          "response": []
        },
