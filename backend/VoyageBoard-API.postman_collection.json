          "response": []
        },
        {
          "name": "Scrape Wikipedia",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"https://en.wikipedia.org/wiki/Web_scraping\",\n  \"extractPlaces\": false\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/scrape",
